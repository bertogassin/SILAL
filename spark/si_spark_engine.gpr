project Si_Spark_Engine is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Languages use ("Ada");
   package Builder is
      for Default_Switches ("Ada") use ("-gnatwa", "-gnat2022");
   end Builder;
   package Prove is
      for Proof_Switches ("Ada") use ("--mode=all", "--level=2");
   end Prove;
end Si_Spark_Engine;
